# =============================================================================
# ENova Jumpoff Template - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk Authentication
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.clerk.com/
# Navigate to: API Keys section
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Clerk Webhook Secret (for syncing users to database)
# Get this from: https://dashboard.clerk.com/ > Webhooks
# Create webhook endpoint: https://yourdomain.com/api/auth/webhook
# Subscribe to: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# -----------------------------------------------------------------------------
# Supabase Database
# -----------------------------------------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Note: Use SERVICE_ROLE_KEY (not anon key) for server-side operations
# This bypasses Row Level Security for admin operations
SUPABASE_SERVICE_KEY=your_service_role_key_here

# -----------------------------------------------------------------------------
# Stripe Payments
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook Secret (for subscription events)
# Get this from: https://dashboard.stripe.com/test/webhooks
# Create webhook endpoint: https://yourdomain.com/api/payments/webhook
# Subscribe to: customer.subscription.*, invoice.payment_*
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (from your Stripe Products)
# Get these from: https://dashboard.stripe.com/test/products
# Create your subscription plans and copy the Price IDs
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_pro_monthly_price_id
STRIPE_PRO_YEARLY_PRICE_ID=price_your_pro_yearly_price_id
STRIPE_BASIC_MONTHLY_PRICE_ID=price_your_basic_monthly_price_id
STRIPE_BASIC_YEARLY_PRICE_ID=price_your_basic_yearly_price_id

# -----------------------------------------------------------------------------
# OpenAI API
# -----------------------------------------------------------------------------
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# -----------------------------------------------------------------------------
# MailerLite Email Marketing (Optional)
# -----------------------------------------------------------------------------
# Get this from: https://dashboard.mailerlite.com/integrations/api
# Used for lead magnets, newsletters, and email automation
MAILERLITE_API_KEY=your_mailerlite_api_key_here
MAILERLITE_GROUP_ID=your_default_group_id_here

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------
# For local webhook testing with ngrok
# Run: ngrok http 3000
# Then paste the https URL here
NGROK_URL=https://your-ngrok-url.ngrok-free.app

# Environment flag for production vs development
IS_PRODUCTION=false

# Enable/disable authentication (useful for development)
ENABLE_AUTH=true

# -----------------------------------------------------------------------------
# Vercel Deployment (Production)
# -----------------------------------------------------------------------------
# These are automatically set by Vercel in production
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-app.vercel.app

# Cron Job Secret (for securing cron endpoints)
# Generate a random string for this: openssl rand -base64 32
CRON_SECRET=your_cron_secret_here

# -----------------------------------------------------------------------------
# Optional: Additional API Keys
# -----------------------------------------------------------------------------
# Add any additional API keys your project needs here
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://your-sentry-dsn
# POSTHOG_KEY=phc_your_posthog_key
